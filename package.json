{
  "name": "@opencryptopay/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "license": "MIT",
  "scripts": {
    "dev": "bun --hot src/index.ts",
    "start": "bun src/index.ts",
    "build": "bun build src/index.ts --target=bun --outdir=dist",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . && prettier --check .",
    "lint:fix": "eslint . --fix && prettier --write .",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "handbook:check": "node scripts/check-handbook.mjs",
    "e2e:check": "node scripts/check-e2e.mjs",
    "db:docs": "bun integration/db-schema-reference.ts --write",
    "db:docs:check": "bun integration/db-schema-reference.ts --check",
    "test:schema": "bun test integration/db-schema-reference.test.ts",
    "e2e": "playwright test"
  },
  "dependencies": {
    "hono": "^4.6.14"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@playwright/test": "^1.55.0",
    "@types/bun": "^1.2.2",
    "@types/node": "^22.10.2",
    "@vitest/coverage-v8": "^2.1.8",
    "eslint": "^9.17.0",
    "eslint-plugin-tsdoc": "^0.4.0",
    "prettier": "^3.4.2",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.18.1",
    "vitest": "^2.1.8"
  }
}
